# =====================================================
# 12週減脂增肌挑戰賽 — 環境變數範本
# 複製此檔為 .env 並填入實際值；.env 已加入 .gitignore
# =====================================================

# --- Supabase 連線 ---
# 在 https://supabase.com 建立專案後，於 Project Settings → API 找到以下值
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 僅伺服器端使用（NEVER prefix with NUXT_PUBLIC_）
# Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- 應用程式設定（可暴露給 client） ---
NUXT_PUBLIC_CHALLENGE_START_DATE=2026-05-07
NUXT_PUBLIC_TOTAL_DAYS=84

# --- Logger 設定（server-only） ---
# Levels: trace | debug | info | warn | error | fatal
NUXT_LOG_LEVEL=info
NUXT_LOG_RETENTION_DAYS=30

# --- 測試 / E2E（僅本地） ---
NUXT_TEST_USER_EMAIL=test@example.com
NUXT_TEST_USER_PASSWORD=changeme-in-real-tests
